{
  "name": "lendctl-ai",
  "version": "0.1.0",
  "description": "Autonomous lending decision agent powered by LendCtl CLI suite",
  "author": "Satyan Avatara <rsatyan@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "lendctl-ai": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent/index.js",
      "types": "./dist/agent/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run src/index.ts",
    "serve": "bun run src/server.ts",
    "eval": "bun run evals/run.ts",
    "test": "bun test",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^4.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "hono": "^4.0.0",
    "zod": "^3.23.0",
    "better-sqlite3": "^11.0.0",
    "@inquirer/prompts": "^7.0.0",
    "telegraf": "^4.16.0",
    "@whiskeysockets/baileys": "^6.7.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rsatyan/lendctl-ai.git"
  },
  "bugs": {
    "url": "https://github.com/rsatyan/lendctl-ai/issues"
  },
  "homepage": "https://github.com/rsatyan/lendctl-ai#readme",
  "keywords": [
    "lending",
    "mortgage",
    "underwriting",
    "ai",
    "agent",
    "autonomous",
    "fintech",
    "cli",
    "lendctl"
  ]
}
